{
  "_NOTE": "EXAMPLE / TEMPLATE ONLY - not a live file. Do NOT copy this into data/companies.json verbatim.",
  "_NOTE_2": "Replace every placeholder with the operator's OWN company/branch values. The operator enters all real business data manually; it is never generated or guessed by an agent.",
  "_NOTE_3": "Schema verified against CompaniesView.js (create-company and add-branch modals). Live data/companies.json is a JSON ARRAY of company objects.",
  "_NOTE_4": "Mandatory to create the first company: nameAr, code, currency, and the initial main branch name (branches[0].nameAr). The UI also auto-generates the first main branch (branchType 'main', payDay 25) when a company is created from the Companies screen.",
  "_NOTE_5": "id values (company and branch) are normally auto-generated by the UI as comp-<timestamp> / br-<timestamp>; placeholders are shown only to make the structure explicit.",
  "_NOTE_6": "parentBranchId must be null for a 'main' branch and set to the parent main branch id for a 'sub' branch.",
  "_NOTE_7": "Edit any production JSON file ONLY while the production server is stopped (see PRODUCTION_SETUP_v1.2.0.md).",
  "companies": [
    {
      "id": "<COMPANY_ID>",
      "nameAr": "<COMPANY_NAME_AR>",
      "nameEn": "<COMPANY_NAME_EN>",
      "code": "<COMPANY_CODE>",
      "commercialRegistration": "<COMMERCIAL_REGISTRATION>",
      "taxNumber": "<TAX_NUMBER>",
      "currency": "<CURRENCY>",
      "currencySymbol": "<CURRENCY_SYMBOL>",
      "hourlyLeaveQuota": "<HOURLY_LEAVE_QUOTA>",
      "branches": [
        {
          "id": "<BRANCH_ID>",
          "companyId": "<COMPANY_ID>",
          "nameAr": "<BRANCH_NAME_AR>",
          "nameEn": "<BRANCH_NAME_EN>",
          "city": "<CITY>",
          "payDay": "<PAY_DAY>",
          "branchType": "<BRANCH_TYPE>",
          "parentBranchId": "<PARENT_BRANCH_ID>"
        }
      ]
    }
  ]
}